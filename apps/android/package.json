{
  "name": "@papaerless/android",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "echo \"(keine Tests)\"",
    "lint": "echo \"(noch kein Linter konfiguriert)\"",
    "sync": "pnpm --filter @papaerless/web build && cap sync android",
    "open": "cap open android",
    "build:apk": "pnpm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
