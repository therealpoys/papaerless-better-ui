# --- Paperless-ngx ---
PAPERLESS_URL=http://localhost:8000
PAPERLESS_API_TOKEN=

# --- Backend (services/api) ---
API_PORT=3001
# Gemeinsames Bearer-Token für apps/web (VITE_API_TOKEN) und apps/mobile
# (EXPO_PUBLIC_API_TOKEN). Leer lassen = Backend bleibt offen (nur lokale Entwicklung!).
# Setzen sobald das Backend außerhalb von localhost erreichbar ist, z.B. via VPN/Reverse Proxy.
API_AUTH_TOKEN=

# --- KI / Klassifizierung (optional, siehe Roadmap "Optional – KI-Erkennung") ---
# Leer lassen = Feature komplett deaktiviert, App läuft unverändert ohne Vorschläge.
AI_PROVIDER=            # z.B. anthropic (openai/ollama folgen ggf. später)
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Erinnerungen / Push (Phase "Später") ---
# Web Push VAPID-Keys erzeugen z.B. via `npx web-push generate-vapid-keys`.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:admin@example.com
# Für Push an die Mobile App (Expo):
EXPO_ACCESS_TOKEN=

# --- Mail-Ingest (services/mail-ingest, Phase "E-Mail") ---
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_FOLDER=INBOX
MAIL_POLL_INTERVAL_MS=60000
