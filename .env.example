# --- Paperless-ngx ---
PAPERLESS_URL=http://localhost:8000
PAPERLESS_API_TOKEN=

# --- Nur für den Docker-Stack (infra/docker-compose.yml, siehe README "Produktiv betreiben") ---
# Von scripts/setup.sh erzeugt. Erst im Paperless-UI ein API-Token erzeugen (Profil > "API Auth Token"),
# dann oben PAPERLESS_API_TOKEN eintragen und den Rest des Stacks starten.
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=
# Öffentliche URL von Paperless (hinter Reverse Proxy z.B. https://paperless.example.org)
PAPERLESS_PUBLIC_URL=http://localhost:8000
# Host-Ports; Default nur localhost -> TLS-Reverse-Proxy/VPN davorsetzen. 0.0.0.0 nur bewusst setzen.
WEB_PORT=8080
WEB_BIND=127.0.0.1
API_BIND=127.0.0.1
PAPERLESS_BIND=127.0.0.1
TZ=Europe/Berlin

# --- Backend (services/api) ---
API_PORT=3001
# Gemeinsames Bearer-Token für apps/web (VITE_API_TOKEN) und apps/mobile
# (EXPO_PUBLIC_API_TOKEN). Leer lassen = Backend bleibt offen (nur lokale Entwicklung!).
# Setzen sobald das Backend außerhalb von localhost erreichbar ist, z.B. via VPN/Reverse Proxy.
API_AUTH_TOKEN=
# Bind-Adresse. Default 0.0.0.0 (Docker/LAN); für reine Lokalentwicklung 127.0.0.1.
# Warnung beim Start, wenn nicht-lokal gebunden und API_AUTH_TOKEN leer.
API_HOST=0.0.0.0
# Erlaubte CORS-Origins, kommagetrennt (z.B. https://docs.example.com). Leer = alle (nur Dev).
CORS_ORIGIN=
# Rate-Limit pro Client-IP (großzügig; /health ausgenommen)
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
# Maximale Upload-Größe in MB
MAX_UPLOAD_MB=50
# Timeout für Requests an Paperless in ms
PAPERLESS_TIMEOUT_MS=15000

# --- KI / Klassifizierung (optional, siehe Roadmap "Optional – KI-Erkennung") ---
# Leer lassen = Feature komplett deaktiviert, App läuft unverändert ohne Vorschläge.
AI_PROVIDER=            # z.B. anthropic (openai/ollama folgen ggf. später)
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Erinnerungen / Push (Phase "Später") ---
# Web Push VAPID-Keys erzeugen z.B. via `npx web-push generate-vapid-keys`.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:admin@example.com
# Für Push an die Mobile App (Expo):
EXPO_ACCESS_TOKEN=

# --- Mail-Ingest (services/mail-ingest, Phase "E-Mail") ---
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_FOLDER=INBOX
MAIL_POLL_INTERVAL_MS=60000
